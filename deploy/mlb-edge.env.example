# Copy to /etc/mlb-edge/mlb-edge.env, fill in, then:
#   sudo chown root:mlbedge /etc/mlb-edge/mlb-edge.env
#   sudo chmod 640 /etc/mlb-edge/mlb-edge.env
#
# Never commit the real file. The poller redacts API keys before writing the
# archive, but this file is the actual secret.

# --- The Odds API -----------------------------------------------------------
# Free tier is 500 credits/month. Credits are billed per region per market per
# call, so regions=us,eu with markets=h2h costs 2 credits a poll. That is
# 2.6 days of 15-minute polling. The poller reads the remaining quota from the
# response header and throttles itself to survive the season; raise the plan and
# it speeds back up on its own with no config change.
ODDS_API_KEY=

# --- Kalshi -----------------------------------------------------------------
# Not credit-metered, so it polls at the full configured cadence.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/etc/mlb-edge/kalshi-private-key.pem

# --- Polymarket (not yet enabled for polling) -------------------------------
# POLYMARKET_API_KEY=

MLB_EDGE_ROOT=/opt/mlb-edge
