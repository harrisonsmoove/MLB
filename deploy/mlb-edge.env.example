# Copy to /etc/mlb-edge/mlb-edge.env, fill in, then:
#   sudo chown root:mlbedge /etc/mlb-edge/mlb-edge.env
#   sudo chmod 640 /etc/mlb-edge/mlb-edge.env
#
# Never commit the real file. The poller redacts API keys before writing the
# archive, but this file is the actual secret.

# --- The Odds API -----------------------------------------------------------
# Free tier is 500 credits/month. Credits are billed per region per market per
# call, so regions=us,eu with markets=h2h costs 2 credits a poll. That is
# 2.6 days of 15-minute polling. The poller reads the remaining quota from the
# response header and throttles itself to survive the season; raise the plan and
# it speeds back up on its own with no config change.
ODDS_API_KEY=

# --- Kalshi -----------------------------------------------------------------
# Not credit-metered, so it polls at the full configured cadence.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/etc/mlb-edge/kalshi-private-key.pem

# --- Polymarket (not yet enabled for polling) -------------------------------
# POLYMARKET_API_KEY=

# --- Alerting ---------------------------------------------------------------
# Without these, alerts go to the journal only -- which nobody reads at 3am,
# which is exactly when a dead poller costs a night of closing lines that
# Tier 0 cannot re-collect.
#
# Setup, in order:
#   1. Message @BotFather in Telegram, send /newbot, follow the prompts.
#      It gives you a token like 8123456789:AAH...  -> TELEGRAM_BOT_TOKEN
#   2. Send your new bot any message. Telegram will not reveal a chat id
#      until the bot has been messaged at least once -- this is the step
#      people miss.
#   3. Find the chat id:
#        mlb-edge test-alert --discover-chat --root /opt/mlb-edge
#      -> TELEGRAM_CHAT_ID  (negative numbers are groups; that is normal)
#   4. Confirm end to end:
#        mlb-edge test-alert --root /opt/mlb-edge
#      Exits non-zero if nothing reached a phone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backup -----------------------------------------------------------------
# Credentials for whatever backup.push_command uses. For DigitalOcean Spaces
# via the aws CLI, these are the Spaces keys, not the DO API token.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=nyc3

MLB_EDGE_ROOT=/opt/mlb-edge
